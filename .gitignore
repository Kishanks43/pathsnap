# ---- Raw data (instructor-supplied; never commit) ----
data/raw/**
!data/raw/.gitkeep

# ---- Derived / intermediate data (regenerate with scripts) ----
data/interim/
data/processed/
data/cache/

# ---- Model weights ----
# Deliverables require weights, but keep them out of normal commits and
# add them deliberately at submission time (repo size limits).
artifacts/**
!artifacts/.gitkeep
!artifacts/README.md

# ---- Experiment outputs (regenerated by runs) ----
experiments/logs/*.log
experiments/logs/runs/
experiments/results/*.parquet
experiments/results/trials.db

# ---- Secrets ----
.env
.env.*
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# ---- Tooling ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- OS / editors ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
